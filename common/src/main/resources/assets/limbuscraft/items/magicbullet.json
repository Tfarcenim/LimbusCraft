{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:charge_type",
    "cases": [
      {
        "when": "arrow",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "on_shelf"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "item/mbicon"
              }
            },
            {
              "when": [
                "firstperson_lefthand",
                "firstperson_righthand"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "item/magicbulletdrawn1fp"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/magicbulletdrawn1"
          }
        }
      },
      {
        "when": "rocket",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "on_shelf"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "item/mbicon"
              }
            },
            {
              "when": [
                "firstperson_righthand",
                "firstperson_lefthand"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "item/magicbulletdrawn7fp"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/magicbulletdrawn7"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "on_shelf"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "item/mbicon"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:crossbow/pull",
          "entries": [
            {
              "threshold": 0.3,
              "model": {
                "type": "minecraft:model",
                "model": "item/magicbulletsmear1"
              }
            },
            {
              "threshold": 0.8,
              "model": {
                "type": "minecraft:model",
                "model": "item/magicbulletsmear2"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/magicbulletrest"
          }
        }
      },
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "on_shelf"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "item/mbicon"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "item/magicbulletrest"
        }
      }
    }
  }
}